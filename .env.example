# Day 20 lab — optional knobs.
#
# Copy this file to `.env` for local Windows defaults; `lab.ps1` loads it
# automatically. Values already exported in the terminal take precedence.
# On macOS/Linux, export a value inline for a single run:
#
#   LAB_N_THREADS=6 make bench
#   LAB_PARALLEL=8 make serve

# ── Chọn model ───────────────────────────────────────────────
# gemma4-e2b   Gemma 4 E2B    ~5.2 GB, cần 8 GB RAM  (mặc định)
# qwen35-0.8b  Qwen3.5 0.8B   ~0.9 GB, cần 4 GB RAM  (nhỏ + nhanh hơn)
# Set TRƯỚC khi chạy `make setup`. Sau đó models/active.json nhớ lựa chọn cho bạn.
LAB_MODEL=

# ── Model + runtime ──────────────────────────────────────────
LAB_N_THREADS=                  # blank = physical core count from hardware.json
LAB_N_CTX=2048                  # total server context; divided across parallel slots
LAB_N_GPU_LAYERS=               # blank = 99 if an accelerator was detected, else 0
LAB_GPU_DEVICE=                 # chat: runtime default; embedding: first available device
LAB_MAX_TOKENS=64               # tokens generated per benchmark request
LAB_TEMPERATURE=0.7

# ── Server (track 02) ────────────────────────────────────────
LAB_PARALLEL=4                  # llama-server --parallel: continuous batching width
LAB_SERVER_PORT=8080            # chat server port. Đổi nếu 8080 đã bị chiếm
                               # (Colab chiếm 8080 — cloud notebook set 8090).
LAB_EMBED_PORT=8081             # embedding server port (bonus C9)
LAB_LOAD_SHORT_TOKENS=48        # Locust short-request output cap
LAB_LOAD_LONG_TOKENS=96         # Locust RAG-request output cap
LAB_LOAD_DURATION=1m            # Locust run time; use 3m for firmer percentiles

# ── Reasoning (Gemma 4 is a thinking model) ──────────────────
# off (default) = thinking disabled, completions return visible content.
# on            = thinking enabled; tokens land in `reasoning_content` and
#                 `message.content` stays empty until thinking ends. Try it with a
#                 larger LAB_MAX_TOKENS to see what reasoning costs in TPOT --
#                 those are decode tokens your user waits through as well.
LAB_REASONING=off

# ── Hugging Face (optional) ──────────────────────────────────
# Only needed if you hit anonymous rate limits. The model repo is NOT gated.
HF_TOKEN=

# ── Bonus B1: source build ───────────────────────────────────
# Extra cmake flags for `make build-llama`. -DGGML_NATIVE=ON and
# -DCMAKE_BUILD_TYPE=Release are always added for you. Examples:
#   -DGGML_CUDA=ON
#   -DGGML_METAL=ON
#   -DGGML_VULKAN=ON
#   -DGGML_HIPBLAS=ON -DAMDGPU_TARGETS=gfx1100
#   -DGGML_NATIVE=OFF          (challenge C7: the generic-baseline comparison)
LLAMA_CMAKE_FLAGS=
LLAMA_BUILD_JOBS=                # blank = min(logical cores, 4); lower if RAM is tight
